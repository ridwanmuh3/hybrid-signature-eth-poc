# Copy this file to .env and fill in your values.
# Do NOT commit the real .env file.

# Ethereum RPC endpoint (e.g., Anvil local node: http://localhost:8540)
ETHEREUM_URL=http://localhost:8540

# Chain ID (31337 for Anvil local node, 11155111 for Sepolia)
CHAIN_ID=31337

# Oracle private key (secp256k1, hex-encoded, 32 bytes)
# Generate with: forge create --help or:
#   python3 -c "import secrets; print('0x'+secrets.token_hex(32))"
# Anvil default account #9: 0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6
ORACLE_PRIVATE_KEY=

# Oracle Ethereum address (derived from ORACLE_PRIVATE_KEY)
ORACLE_ADDRESS=

# Deployed contract address (after running `make compile-contract && make forge-deploy`)
CONTRACT_ADDRESS=

# --- Test Configuration (used by onchain_test.go) ---
TEST_SENDER_ADDRESS=
TEST_RECEIVER_ADDRESS=
TEST_ENABLED=false
